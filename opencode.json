{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "qf-plan": {
      "description": "QuantFlow spec author. Reads design inputs, writes proposal/specs/design/tasks.",
      "steps": 40,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*openspec/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "openspec *",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_get_repo_skeleton",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_rip_file_lines",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_find_dependent_references",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_apply_search_replace",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness-tools_execute_and_capture",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "qf-build": {
      "description": "Implementer. Writes code and tests; runs ruff, mypy, pytest.",
      "steps": 100,
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness-tools_execute_and_capture",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "qf-review": {
      "description": "Read-only reviewer. Produces findings; never edits.",
      "steps": 15,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_get_repo_skeleton",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_rip_file_lines",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_find_dependent_references",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_apply_search_replace",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness-tools_execute_and_capture",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "qf-doubt": {
      "description": "Read-only adversarial review in isolation.",
      "steps": 10,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_get_repo_skeleton",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_rip_file_lines",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_find_dependent_references",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "harness-tools_apply_search_replace",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "harness-tools_execute_and_capture",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
